/w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:before="240" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="148B8C"/><w:sz w:val="34"/></w:rPr><w:t>نبذة عن منصة نبض</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="120" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="22"/></w:rPr><w:t>نبض منصة طبية عالمية متكاملة ومدعومة بالذكاء الاصطناعي، صُممت لمساعدة الأطباء، وتسهيل عملهم، ورفع كفاءة الممارسة الطبية، وتحسين تجربة المريض من خلال أدوات ذكية تجمع المعرفة والتحليل والإدارة في منصة واحدة.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="120" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="22"/></w:rPr><w:t>تهدف نبض إلى إحداث نقلة نوعية في طريقة استخدام التقنية والذكاء الاصطناعي في الممارسة الطبية، من خلال تمكين الطبيب من الوصول إلى المعلومات بصورة أسرع وأكثر تنظيمًا، وتقليل الوقت المستغرق في الإجراءات والتوثيق والبحث، بما يمنحه وقتًا أكبر للتركيز على المريض.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:before="240" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="148B8C"/><w:sz w:val="34"/></w:rPr><w:t>ماذا تقدم نبض؟</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="160" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="12364D"/><w:sz w:val="26"/></w:rPr><w:t>الكشف الطبي الذكي</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="80" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="21"/></w:rPr><w:t>تساعد نبض الطبيب أثناء الكشف في تحليل وتنظيم المحادثة والمعلومات الطبية، واستخلاص الأعراض والتاريخ المرضي والملاحظات المهمة، وإعداد ملخص منظم للحالة لمراجعة الطبيب واعتماده.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="160" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="12364D"/><w:sz w:val="26"/></w:rPr><w:t>دعم التشخيص والقرار الطبي</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="80" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="21"/></w:rPr><w:t>تساعد المنصة الطبيب في تحليل بيانات الحالة وعرض التشخيصات المحتملة والفحوصات والتحاليل والخيارات العلاجية والأدوية ذات الصلة، بما يوفر معلومات مساندة لاتخاذ القرار السريري.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="160" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="12364D"/><w:sz w:val="26"/></w:rPr><w:t>مساعد نبض الذكي</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="80" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="21"/></w:rPr><w:t>مساعد معرفي ذكي لخدمة الأطباء، يسهّل البحث والوصول إلى المعلومات الطبية والأدوية والجرعات والتداخلات الدوائية والإرشادات والمراجع، ويتيح للطبيب طرح الأسئلة الطبية والحصول على معلومات منظمة ومصادر ذات صلة.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="160" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="12364D"/><w:sz w:val="26"/></w:rPr><w:t>التحاليل والأشعة</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="80" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="21"/></w:rPr><w:t>إضافة التحاليل والأشعة وربطها بملف المريض، مع الاستفادة من الذكاء الاصطناعي في تحليل البيانات وتلخيص النتائج وإبراز المؤشرات والملاحظات المهمة لمراجعة الطبيب.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="160" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="12364D"/><w:sz w:val="26"/></w:rPr><w:t>التقارير والخدمات الطبية</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="80" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="21"/></w:rPr><w:t>تسهّل نبض إعداد التقارير الطبية وملخصات الزيارات والوصفات والإجازات المرضية وتقارير المتابعة والإحالة، اعتمادًا على المعلومات المسجلة في ملف المريض، مع إمكانية مراجعتها واعتمادها من الطبيب.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/><w:spacing w:before="160" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="12364D"/><w:sz w:val="26"/></w:rPr><w:t>إدارة المرضى والمساعدين</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="80" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="21"/></w:rPr><w:t>ملف طبي متكامل يجمع تاريخ المريض والكشوفات والأدوية والتحاليل والأشعة والتقارير والمرفقات، بالإضافة إلى إدارة المواعيد والمتابعات وإضافة مساعدين للطبيب وتحديد صلاحياتهم.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:before="240" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="148B8C"/><w:sz w:val="34"/></w:rPr><w:t>دقة أكبر ومعلومات أكثر تنظيمًا</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="120" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="22"/></w:rPr><w:t>تساعد نبض على رفع جودة ودقة المعلومات المتاحة للطبيب من خلال جمع بيانات الحالة في مكان واحد، وتنظيمها وتحليلها وربط المعلومات ذات العلاقة ببعضها.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="120" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:sz w:val="22"/></w:rPr><w:t>كما يمكن لأدوات الدعم الذكي أن تساعد في لفت انتباه الطبيب إلى معلومات مهمة، مثل الحساسية الدوائية، والتداخلات بين الأدوية، والنتائج غير الطبيعية، والمعلومات الناقصة أو التي تحتاج إلى مراجعة. ويسهم ذلك في الحد من احتمالات السهو والأخطاء المرتبطة بنقص المعلومات أو تشتتها، ودعم الطبيب بمعلومات أكثر وضوحًا قبل اتخاذ القرار الطبي.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:before="0" w:after="120" w:line="300" w:lineRule="auto"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="12364D"/><w:sz w:val="22"/></w:rPr><w:t>نبض لا تستبدل الطبيب، بل تمنحه أدوات إضافية تساعده على العمل بدقة وكفاءة أكبر.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:before="240" w:after="120"/><w:jc w:val="right"/><w:bidi w:val="1"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:b/><w:color w:val="148B8C"/><w:sz w:val="34"/></w:rPr><w:t>وقت أقل 